<header class="hero" style="padding: var(--space-12) 0;">
  <div class="container">
    <h1 class="text-4xl font-bold text-center mb-4">Form Demo</h1>
    <p class="text-lg text-secondary text-center max-w-2xl mx-auto">Showcase of accessible, validated form components with modern styling.</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="form-page">
      <div class="form-card card">
        <h2 class="form-title">Contact Form</h2>
        <p class="form-subtitle">All fields are validated client-side with proper accessibility attributes.</p>
        <form id="demo-form" class="form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="fname" class="form-label">First Name <span aria-hidden="true">*</span></label>
              <input type="text" id="fname" name="firstname" class="form-input" required autocomplete="given-name" aria-required="true" placeholder="Nama Lengkapmu..">
              <p class="form-error" id="fname-error" aria-live="polite"></p>
            </div>
            <div class="form-group">
              <label for="lname" class="form-label">Last Name</label>
              <input type="text" id="lname" name="lastname" class="form-input" autocomplete="family-name" placeholder="Belakang">
            </div>
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" class="form-input" required autocomplete="email" aria-required="true" placeholder="Emailmu disini..">
            <p class="form-error" id="email-error" aria-live="polite"></p>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="age" class="form-label">Age</label>
              <input type="number" id="age" name="age" class="form-input" min="1" max="120" autocomplete="age" placeholder="Umurmu...">
              <p class="form-error" id="age-error" aria-live="polite"></p>
            </div>
            <div class="form-group">
              <label for="country" class="form-label">Country</label>
              <select id="country" name="country" class="form-select" autocomplete="country">
                <option value="">Select country</option>
                <option value="indonesia">Indonesia</option>
                <option value="usa">United States</option>
                <option value="canada">Canada</option>
                <option value="australia">Australia</option>
                <option value="singapore">Singapore</option>
                <option value="japan">Japan</option>
                <option value="germany">Germany</option>
                <option value="netherlands">Netherlands</option>
              </select>
            </div>
          </div>
          <fieldset class="form-group">
            <legend class="form-label">Newsletter</legend>
            <div class="form-check">
              <input type="checkbox" id="newsletter" name="newsletter" class="form-check-input" value="yes">
              <label for="newsletter" class="form-check-label">Subscribe to updates</label>
            </div>
          </fieldset>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Submit</button>
            <button type="reset" class="btn btn-secondary">Reset</button>
          </div>
          <div id="demo-form-status" class="hidden mt-4 p-4 rounded-lg" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>