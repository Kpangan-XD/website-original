<header class="hero" style="padding: var(--space-12) 0;">
  <div class="container">
    <h1 class="text-4xl font-bold text-center mb-4">Contact</h1>
    <p class="text-lg text-secondary text-center max-w-2xl mx-auto">Have a project in mind? Questions about our work? We'd love to hear from you.</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="contact-details">
            <h3 class="font-semibold">Email</h3>
            <p class="text-secondary">hello@inpianda.dev</p>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="contact-details">
            <h3 class="font-semibold">Location</h3>
            <p class="text-secondary">Indonesia (Remote)</p>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <div class="contact-details">
            <h3 class="font-semibold">GitHub</h3>
            <p class="text-secondary"><a href="https://github.com/inpianda" class="link" target="_blank" rel="noopener noreferrer">github.com/inpianda</a></p>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="contact-details">
            <h3 class="font-semibold">Response Time</h3>
            <p class="text-secondary">Usually within 24 hours</p>
          </div>
        </div>
      </div>

      <div class="form-card card">
        <h2 class="form-title">Send a Message</h2>
        <p class="form-subtitle">Fill out the form and we'll get back to you as soon as possible.</p>
        <form id="contact-form" class="form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">Name <span aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" class="form-input" required autocomplete="name" aria-required="true">
              <p class="form-error" id="name-error" aria-live="polite"></p>
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required autocomplete="email" aria-required="true">
              <p class="form-error" id="email-error" aria-live="polite"></p>
            </div>
          </div>
          <div class="form-group">
            <label for="subject" class="form-label">Subject <span aria-hidden="true">*</span></label>
            <select id="subject" name="subject" class="form-select" required aria-required="true">
              <option value="">Select a topic</option>
              <option value="project">Project Inquiry</option>
              <option value="collaboration">Collaboration</option>
              <option value="feedback">Feedback</option>
              <option value="other">Other</option>
            </select>
            <p class="form-error" id="subject-error" aria-live="polite"></p>
          </div>
          <div class="form-group">
            <label for="message" class="form-label">Message <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" class="form-textarea" rows="5" required aria-required="true" placeholder="Describe your project or question..."></textarea>
            <p class="form-error" id="message-error" aria-live="polite"></p>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Send Message</button>
            <button type="reset" class="btn btn-secondary">Clear</button>
          </div>
          <p id="form-status" class="visually-hidden" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>