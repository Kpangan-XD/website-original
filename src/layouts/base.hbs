<!DOCTYPE html>
<html lang="id" data-theme="system">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{description}}">
  <meta name="theme-color" content="#1a1a2e">
  <title>{{title}} | Inpianda Center</title>

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">

  <!-- Critical CSS inline (generated by Vite) -->
  {{#if criticalCSS}}<style>{{criticalCSS}}</style>{{/if}}

  <!-- Preload hero image -->
  {{#if heroImage}}<link rel="preload" as="image" href="{{heroImage}}">{{/if}}

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">{{{structuredData}}}</script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {{> header }}

  <main id="main-content" role="main">
    {{{body}}}
  </main>

  {{> footer }}

  <!-- Register Service Worker -->
  <script type="module">
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>

  <!-- Page-specific scripts -->
  {{#if pageScript}}<script type="module" src="{{pageScript}}"></script>{{/if}}
</body>
</html>